# syntax=docker/dockerfile:1.29-labs
FROM --reset=volume,entrypoint {{FROM}}

USER root

# glibc-static is needed because runit links its binaries statically.
RUN yum install -y git sudo openssh-clients ca-certificates net-tools bzip2 \
      vim-enhanced nmap-ncat make gcc gcc-c++ rsync wget tar jq glibc-static && \
    \
    echo "[user]" > ~/.gitconfig && \
    echo "    email = root@tugboat.qa" >> ~/.gitconfig && \
    echo "    name = Tugboat" >> ~/.gitconfig && \
    ln -sf /usr/share/zoneinfo/Etc/UTC /etc/localtime && \
    \
    mkdir -p /etc/service && \
    ln -s /etc/service /service && \
    mkdir /package && \
    cd /package && \
    wget -q https://smarden.org/runit/runit-2.1.2.tar.gz && \
    echo "6fd0160cb0cf1207de4e66754b6d39750cff14bb0aa66ab49490992c0c47ba18  runit-2.1.2.tar.gz" | sha256sum -c - && \
    tar -zxf runit-2.1.2.tar.gz && \
    rm runit-2.1.2.tar.gz && \
    cd admin/runit-2.1.2 && \
    package/install

# Configure locale
ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8

{{DOCKERFILE}}

RUN yum clean all -y && \
    rm -rf /tmp/* /var/tmp/*

{{RUN}}

STOPSIGNAL SIGTERM

ENV RUNITDIR=/usr/local/bin/

COPY runit-init.sh /runit-init.sh

CMD ["/runit-init.sh"]
